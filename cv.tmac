.\" vim: ft=groff
.nr FIG_PAD 1.2m \" figure padding
.nr VSPC    120  \" vertical space as % of text size
.ss 12 0
.
.aln VERT_POS nl
.
.pl 11.7i \" page length (A4)
.ll 6.3i  \" line length (A4 minus margins)
.
.de SIZE
.   ps \\$1
.   vs ((\\n[.s] * \\n[VSPC]) / 100)
..
.SIZE 11
.
.de HEAD
.   ad c
..
.de NAME
.   nop \s[36]\\$^\s[0]
..
.de SUBHEAD
.   sp 0.5
.   if (\\n[.$] > 0) .nop \\$^
..
.de HEAD_END
.   br
.   ce 1
.   nop \l'3i'
.   ad n
.   sp
..
.de LIST
.   br
.   vs ((\\n[.v]u * \\n[VSPC]) / 100)
.   nr LIST_TOP  \\n[VERT_POS]
.   nr MAX_ROWS  \\$1
.   nr COL_WIDTH \\$2
.   nr ITEM_NUM  0
.   nr COL_NUM   0
..
.de LI
.   nr COL_NUM  (\\n[ITEM_NUM] / \\n[MAX_ROWS])
.   nr ITEM_NUM (\\n[ITEM_NUM] + 1)
.   nr INDENT   (\\n[COL_NUM] * \\n[COL_WIDTH])
.   ti +(\\n[INDENT] + \\n[FIG_PAD]u)
.   nop \(bu \\$^
.   if ( (\\n[ITEM_NUM] % \\n[MAX_ROWS]) = 0 ) \
.       sp (\\n[LIST_TOP]u - \\n[VERT_POS]u)
..
.de LIST_END
.   vs
.   sp ((\\n[LIST_TOP]u + \\n[MAX_ROWS]v + 1v) - \\n[VERT_POS]u))
..
.de SECTION
.   sp
.   nop \d\l'\\n[.l]u'\h'-\\n[.l]u'\u\c
.   nop \fB\\$^\fP
.   sp .5
..
.de TIMELINE_DATE
.   ds DATES \\$1 - \\$2
.   shift 2
.   ps 15
.   sp .5
.   nop \\$^
.   sp -1
.   ad r
.   nop \fI\\*[DATES]\fP
.   sp .2
.   ad n
.   ps
..
.de P
.   in +1m
.   nop \(bu \\$^
.   in -1m
.   sp .2
..
.de HREF
.    pdfhref W -D https://\\$^ -- \\$^
..
.de HEADER
'   sp 0.75i
..
.de FOOTER
'   sp (0.5i - 1v)
.   ev foot
.       ce 1
.       nop The source code for this document is available at: \c
.       HREF github.com/cianbagshaw/cv
.   ev
'   bp
..
.wh 0   HEADER
.wh -1i FOOTER
