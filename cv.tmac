.\" vim: ft=groff
.nr FIG_PAD 1.2m \" figure padding
.nr VSPC    120  \" vertical space as % of text size
.
.aln VERT_POS nl
.
.pl 11.7i \" page length (A4)
.ll 6.3i  \" line length (A4 minus margins)
.
.de SIZE
.   ps \\$1
.   vs ((\\n[.s] * \\n[VSPC]) / 100)
..
.SIZE 12
.
.de LEFT_RULE
.   br
.   nr RULE_TOP \\n[VERT_POS]
.   in +1n
..
.de LEFT_RULE_END
.   in -1n
.   nr RULE_HEIGHT (\\n[VERT_POS] - \\n[RULE_TOP])
.   sp -1
.   nop \L'-\\n[RULE_HEIGHT]u'
.   br
..
.de HEAD
.   ad c
..
.de NAME
.   nop \s[36]\\$^\s[0]
..
.de SUBHEAD
.   sp 0.5
.   if (\\n[.$] > 0) .nop \\$^
..
.de HEAD_END
.   br
.   ce 1
.   nop \l'3i'
.   ad n
.   sp
..
.de LIST
.   br
.   vs ((\\n[.v]u * \\n[VSPC]) / 100)
.   nr LIST_TOP  \\n[VERT_POS]
.   nr MAX_ROWS  \\$1
.   nr COL_WIDTH \\$2
.   nr ITEM_NUM  0
.   nr COL_NUM   0
..
.de LI
.   nr COL_NUM  (\\n[ITEM_NUM] / \\n[MAX_ROWS])
.   nr ITEM_NUM (\\n[ITEM_NUM] + 1)
.   nr INDENT   (\\n[COL_NUM] * \\n[COL_WIDTH])
.   ti +(\\n[INDENT] + \\n[FIG_PAD]u)
.   nop \(bu \\$^
.   if ( (\\n[ITEM_NUM] % \\n[MAX_ROWS]) = 0 ) \
.       sp (\\n[LIST_TOP]u - \\n[VERT_POS]u)
..
.de LIST_END
.   vs
.   sp ((\\n[LIST_TOP]u + \\n[MAX_ROWS]v + 1v) - \\n[VERT_POS]u))
..
.de SECTION
.   sp
.   nop \d\l'\\n[.l]u'\h'-\\n[.l]u'\u\c
.   nop \fB\\$^\fP
.   sp .5
..
.de TIMELINE_DATE
.   sp .5
.   in +\\n[FIG_PAD]u
.   ll -\\n[FIG_PAD]u
.   nop \fI\\$1 \- \\$2\fP
.   in +1i
.   sp -1
.   LEFT_RULE
.   shift 2
.   nop \fB\\$^\fP
.   br
..
.de TIMELINE_DATE_END
.   LEFT_RULE_END
.   in -(1i + \\n[FIG_PAD]u)
.   ll +\\n[FIG_PAD]u
..
.de HREF
.    pdfhref W -D https://\\$^ -- \\$^
..
.de HEADER
'   sp 0.75i
..
.de FOOTER
'   sp (0.5i - 1v)
.   ev foot
.       ce 1
.       nop The source code for this document is available at: \c
.       HREF github.com/cianbagshaw/cv
.   ev
'   bp
..
.wh 0   HEADER
.wh -1i FOOTER
